#cloud-config
# Release runner (release-runner.tf): Docker Engine with buildx and compose,
# the GitHub Actions runner package (pinned, SHA-256 checked) in
# /opt/actions-runner owned by the `runner` user, not registered (README.md,
# section 3), and the ECR credential helper, which signs every push with the
# instance role: no docker login, no stored password.
package_update: true
packages:
  - ca-certificates
  - curl
  - git
  - gnupg
  - jq
  - make
  - unzip
  - build-essential
  - amazon-ecr-credential-helper
write_files:
  - path: /usr/local/sbin/margince-runner-setup
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      # Docker Engine from Docker's apt repository; its signing key is
      # checked against the fingerprint Docker publishes.
      install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
      gpg --show-keys --with-colons /etc/apt/keyrings/docker.asc | grep -q '^fpr:::::::::9DC858229FC7DD38854AE2D88D81803C0EBFCD88:'
      chmod a+r /etc/apt/keyrings/docker.asc
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
      apt-get update
      apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

      # The runner account: in the docker group, no sudo.
      id runner >/dev/null 2>&1 || useradd --create-home --shell /bin/bash runner
      usermod -aG docker runner

      # Registry credentials from the instance role, through the ECR
      # credential helper (docker-credential-ecr-login).
      install -d -m 0700 -o runner -g runner /home/runner/.docker
      cat > /home/runner/.docker/config.json <<'JSON'
      { "credHelpers": { "${registry_host}": "ecr-login" } }
      JSON
      chown runner:runner /home/runner/.docker/config.json
      chmod 0600 /home/runner/.docker/config.json

      # GitHub Actions runner ${runner_version}, SHA-256 checked before unpacking.
      curl -fsSL -o /tmp/actions-runner.tar.gz https://github.com/actions/runner/releases/download/v${runner_version}/actions-runner-linux-${runner_arch}-${runner_version}.tar.gz
      echo "${runner_sha256}  /tmp/actions-runner.tar.gz" | sha256sum -c -
      install -d -o runner -g runner /opt/actions-runner
      tar -xzf /tmp/actions-runner.tar.gz -C /opt/actions-runner
      rm /tmp/actions-runner.tar.gz
      chown -R runner:runner /opt/actions-runner
      /opt/actions-runner/bin/installdependencies.sh
runcmd:
  - [bash, /usr/local/sbin/margince-runner-setup]
